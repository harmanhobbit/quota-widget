<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher-facing description of the Quota Widget home-screen widget
  (issue #113). `configure` points at the placement activity so dropping a
  widget opens configuration; `resizeMode` allows both axes so the responsive
  small/medium/large tiers can be chosen from the real cell size. The minimum
  sizes bracket the small tier; `targetCellWidth/Height` hint a medium default.
  `initialLayout` is the Glance loading layout, replaced as soon as the first
  composition renders.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="tech.allaway.quotawidget.widget.WidgetConfigActivity"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/glance_default_loading_layout" />
