# direnv: enter the flake's devShell on cd, leave it on cd out.
#
# First use needs `direnv allow` (direnv refuses to run an unreviewed .envrc,
# which is the point of it). Install nix-direnv for a cached shell — plain
# `use flake` re-evaluates on every prompt and is noticeably slow:
#
#   nix profile install nixpkgs#nix-direnv
#
# and in ~/.config/direnv/direnvrc:
#
#   source $HOME/.nix-profile/share/nix-direnv/direnvrc
use flake

# Keep cargo's build dir out of the Nix store path and stable across shells.
# Not strictly needed, but makes `direnv reload` cheap — the 7.6 GB target/
# survives it.
export CARGO_TARGET_DIR="$PWD/target"
